# Copy to a root-owned/0600 runtime environment file. Never commit the copy.
HERMES_AGENT_ROOT=/home/ubuntu/hermes-agent
HERMES_KANBAN_HOME=/home/ubuntu/.hermes
HERMES_KANBAN_BOARD=codex_app_server

# Public HTTPS origin used in OAuth metadata and token audience checks.
MCP_PUBLIC_BASE_URL=https://kanban.hermesinthenight.duckdns.org
MCP_HOST=127.0.0.1
MCP_PORT=8789

# Required private connector credentials. Use a password manager or the OCI installer.
MCP_OAUTH_USERNAME=chatgpt
MCP_OAUTH_PASSWORD=replace-with-a-random-24-character-password
MCP_OAUTH_SIGNING_KEY=replace-with-at-least-32-random-characters

# Optional bounds; lower values are safe defaults for a public read service.
MCP_MAX_PAGE_SIZE=100
MCP_MAX_GRAPH_DEPTH=3
MCP_MAX_GRAPH_NODES=100
MCP_MAX_BODY_CHARS=64000
MCP_MAX_LOG_BYTES=32000
MCP_MAX_ACTIVITY_ITEMS=200
MCP_OAUTH_CODE_TTL=300
MCP_OAUTH_TOKEN_TTL=3600
