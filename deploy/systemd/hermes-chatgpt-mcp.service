[Unit]
Description=Hermes ChatGPT MCP service (read plus safe task creation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/code/hermes-chatgpt-mcp
EnvironmentFile=/home/ubuntu/.hermes/hermes-chatgpt-mcp.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MCP_OAUTH_STATE_FILE=/var/lib/hermes-chatgpt-mcp/oauth-state.json
# OAuth diagnostics are disabled during normal operation.
Environment=MCP_OAUTH_DIAGNOSTICS=0
ExecStart=/home/ubuntu/hermes-agent/venv/bin/python -m hermes_chatgpt_mcp.server
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
StateDirectory=hermes-chatgpt-mcp
StateDirectoryMode=0700
# Keep the Hermes home read-only and reopen only the canonical board storage.
# The installer creates the legacy WAL/SHM sidecars when absent. systemd then
# bind-mounts those individual files, so SQLite can update them without
# granting the service write access to unrelated Hermes state.
ReadOnlyPaths=/home/ubuntu/.hermes
ReadWritePaths=/home/ubuntu/.hermes/kanban/boards /home/ubuntu/.hermes/kanban.db /home/ubuntu/.hermes/kanban.db-wal /home/ubuntu/.hermes/kanban.db-shm /var/lib/hermes-chatgpt-mcp
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-chatgpt-mcp

[Install]
WantedBy=multi-user.target
