[Unit]
Description=Hermes ChatGPT MCP service (read plus safe task creation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/code/hermes-chatgpt-mcp
EnvironmentFile=/home/ubuntu/.hermes/hermes-chatgpt-mcp.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MCP_OAUTH_STATE_FILE=/var/lib/hermes-chatgpt-mcp/oauth-state.json
# Temporary, opt-in-safe OAuth handshake diagnostics for the 2026-08-16 experiment.
Environment=MCP_OAUTH_DIAGNOSTICS=1
ExecStart=/home/ubuntu/hermes-agent/venv/bin/python -m hermes_chatgpt_mcp.server
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
StateDirectory=hermes-chatgpt-mcp
StateDirectoryMode=0700
ReadWritePaths=/home/ubuntu/.hermes/kanban/boards/codex_app_server /home/ubuntu/.hermes/kanban/boards/dashboard /var/lib/hermes-chatgpt-mcp
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-chatgpt-mcp

[Install]
WantedBy=multi-user.target
