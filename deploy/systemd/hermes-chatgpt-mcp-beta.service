[Unit]
Description=Hermes ChatGPT MCP beta service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/code/hermes-chatgpt-mcp/.worktrees/hermes-chatgpt-mcp-beta
EnvironmentFile=/home/ubuntu/.hermes/hermes-chatgpt-mcp-beta.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MCP_SURFACE=beta
Environment=MCP_PORT=8791
Environment=MCP_BOARD_CREATE_ENABLED=1
Environment=MCP_OAUTH_STATE_FILE=/var/lib/hermes-chatgpt-mcp-beta/oauth-state.json
# OAuth diagnostics are disabled during normal operation.
Environment=MCP_OAUTH_DIAGNOSTICS=0
ExecStart=/home/ubuntu/hermes-agent/venv/bin/python -m hermes_chatgpt_mcp.beta_server
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
StateDirectory=hermes-chatgpt-mcp-beta
StateDirectoryMode=0700
# The beta process can access only canonical named-board storage. The legacy
# root database and unrelated Hermes service state stay outside this boundary.
ReadWritePaths=/home/ubuntu/.hermes/kanban/boards /var/lib/hermes-chatgpt-mcp-beta
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-chatgpt-mcp-beta

[Install]
WantedBy=multi-user.target
